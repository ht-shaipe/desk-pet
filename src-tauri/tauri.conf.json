{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Pet",
  "version": "0.1.3",
  "identifier": "com.deskpet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1820",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Desk Pet",
        "width": 72,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "notify",
        "title": "Desk Pet",
        "url": "notify.html",
        "width": 460,
        "height": 190,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ht-shaipe/desk-pet/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NDJFM0E5MDExQzFBN0MKUldSOEdod0JxZU5DaEFyV0dIUkJrV2xMQ1grNHh4OHhYVUd3OUFFOHV4MDdJRXVRNWRUUVNNWXgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
